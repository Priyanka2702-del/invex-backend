NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/invex
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma separated: user app + admin app origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_BASE_URL=http://localhost:5001
UPLOAD_DIR=uploads
# Shared secret the MT5 bridge sends in the x-api-key header when posting closed trades
MT5_WEBHOOK_KEY=change-me-too
ENABLE_CRON=true
# Used by `npm run seed` to create the first super admin
ADMIN_EMAIL=admin@invextrade.com
ADMIN_PASSWORD=ChangeMe123!
MT5_API_URL=
MT5_API_KEY=
USER_APP_URL=http://localhost:3000

# Alpaca (paper trading by default). Keys: https://app.alpaca.markets  -> Paper -> API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex
ALPACA_ALLOW_LIVE=false
ALPACA_SYNC_INTERVAL_MS=5000
